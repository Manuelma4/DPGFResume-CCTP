# Enable only after Certbot has created the certificate for dpgf.moduo.fr.
<IfModule mod_ssl.c>
<VirtualHost *:443>
    ServerName dpgf.moduo.fr

    SSLEngine on
    SSLCertificateFile /etc/letsencrypt/live/dpgf.moduo.fr/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/dpgf.moduo.fr/privkey.pem

    ProxyPreserveHost On
    ProxyRequests Off
    RequestHeader set X-Forwarded-Proto "https"
    RequestHeader set X-Forwarded-Port "443"

    ProxyPass        / http://127.0.0.1:8070/ connectiontimeout=10 timeout=900
    ProxyPassReverse / http://127.0.0.1:8070/

    Header always set Strict-Transport-Security "max-age=31536000"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "same-origin"

    ErrorLog ${APACHE_LOG_DIR}/dpgf-ssl-error.log
    CustomLog ${APACHE_LOG_DIR}/dpgf-ssl-access.log combined
</VirtualHost>
</IfModule>
