# En production. Pour le développement local, utiliser un client OIDC séparé.
DPGF_ENVIRONMENT=production
DPGF_AUTH_REQUIRED=true
DPGF_PUBLIC_URL=https://dpgf.moduo.fr
DPGF_SESSION_SECRET=replace-with-a-long-random-secret-generated-on-the-server
DPGF_SESSION_COOKIE_SECURE=true
DPGF_SESSION_TTL_SECONDS=28800

# Moduo Connect / OpenID Connect (obligatoire en production).
# Utiliser un client separe pour le developpement local.
OIDC_ISSUER_URL=https://auth.moduo.fr/application/o/dpgf-resume-cctp
OIDC_CLIENT_ID=dpgf-resume-cctp
OIDC_CLIENT_SECRET=replace-with-the-dpgf-resume-cctp-client-secret
OIDC_REDIRECT_URI=https://dpgf.moduo.fr/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=https://dpgf.moduo.fr/
OIDC_SCOPES=openid profile email
OIDC_REQUIRED_GROUP=Moduo Access - DPGF Resume CCTP
OIDC_HTTP_TIMEOUT=12

# Extraction assistée facultative via le service LIHA compatible OpenAI.
# Les extractions déterministes restent toujours disponibles et traçables.
DPGF_USE_LLM=false
DPGF_LLM_TIMEOUT=180

DPGF_MAX_FILE_MB=80
DPGF_MAX_DOCUMENTS=30

LIHA_CHAT_URL=https://app.liha.fr
LIHA_CHAT_COMPLETIONS_URL=https://app.liha.fr/openai/chat/completions
LIHA_CHAT_MODEL=Moduo.gpt-oss-120b
LIHA_CHAT_TOKEN=
LIHA_CHAT_TIMEOUT_SECONDS=15
LIHA_RULES_SUGGEST_TIMEOUT_SECONDS=700
